run = "uv run uvicorn app.main:app --host 0.0.0.0 --port $PORT"
entrypoint = "app/main.py"
modules = ["python-3.11", "nodejs-20", "web", "postgresql-16"]

[deployment]
run = ["sh", "-c", "uv sync && uv run uvicorn app.main:app --host 0.0.0.0 --port $PORT"]

[[gitignore]]
name = ".venv"

[[gitignore]]
name = "data/"

[[gitignore]]
name = "__pycache__"

[[gitignore]]
name = "*.pyc"

[[gitignore]]
name = ".local"

[[gitignore]]
name = "*.db"

[[gitignore]]
name = ".env"

[[gitignore]]
name = "node_modules"

[[gitignore]]
name = "*.sqlite"

[[gitignore]]
name = "*.sqlite-wal"

[[gitignore]]
name = "*.sqlite-shm"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run uvicorn app.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
