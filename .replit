run = "uv run uvicorn app.main:app --host 0.0.0.0 --port $PORT"
entrypoint = "app/main.py"
modules = ["python-3.11", "nodejs-20", "web"]

[deployment]
run = ["sh", "-c", "uv sync && uv run uvicorn app.main:app --host 0.0.0.0 --port $PORT"]

[[gitignore]]
name = ".venv"

[[gitignore]]
name = "data/"

[[gitignore]]
name = "__pycache__"

[[gitignore]]
name = "*.pyc"

[[gitignore]]
name = ".local"

[[gitignore]]
name = "*.db"

[[gitignore]]
name = ".env"

[[gitignore]]
name = "node_modules"

[[gitignore]]
name = "*.sqlite"

[[gitignore]]
name = "*.sqlite-wal"

[[gitignore]]
name = "*.sqlite-shm"

[nix]
channel = "stable-25_05"
